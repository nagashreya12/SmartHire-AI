# Server
PORT=5000

# MongoDB connection string (get a free cluster at https://www.mongodb.com/cloud/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resume-analyzer?retryWrites=true&w=majority

# JWT secret - use a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Used to encrypt each user's Groq API key before storing it in MongoDB
# Use a long random string (32+ characters recommended)
ENCRYPTION_KEY=change_this_to_a_different_long_random_string

# Optional: override the Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
